# ===== Servidor =====
PORT=3000
# URL publica do servico. Precisa bater com o redirect cadastrado na Twitch e
# com a notification_url do Mercado Pago. Em dev pode ser o endereco do tunel.
BASE_URL=http://localhost:3000
NODE_ENV=development

# ===== Banco =====
# Com DATABASE_URL, usa Postgres de verdade (Neon, Railway, VPS).
# Sem ela, o app cria um Postgres local em data/pg (PGlite) - dev sem instalar nada.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ===== Twitch (dev.twitch.tv/console) =====
# App PROPRIO da Boss Raid - nao reaproveite o do SubPack. A Twitch so deixa
# reembolsar resgates de recompensas criadas pelo mesmo Client ID, entao as
# recompensas "Ataque"/"Ataque Forte" pertencem a este app.
# O app precisa ser "Confidencial" e ter estes redirects cadastrados:
#   http://localhost:3000/auth/twitch/callback
#   https://SEU-DOMINIO/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ===== Chaves do app =====
# Em dev elas se geram sozinhas no .env. Em producao, gere com: npm run gerar-chaves
# APP_SECRET_KEY assina o cookie de sessao.
# TOKEN_ENCRYPTION_KEY cifra os tokens da Twitch no banco - trocar essa chave
# obriga TODOS os canais a reconectar a conta.
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# ===== Cobranca =====
# manual = voce ativa e desativa canal na mao. mercadopago = cobranca automatica.
BILLING_PROVIDER=manual
PRECO_MENSAL=19.90

# Credenciais em: mercadopago.com.br/developers/panel > sua aplicacao
MP_ACCESS_TOKEN=
# Segredo da assinatura do webhook: painel do MP > Webhooks > Configurar notificacao.
# Sem ele, o app recusa toda notificacao - de proposito.
MP_WEBHOOK_SECRET=
